NETCAT SCANNING:
    |-->  nc [Options] [Target IP] [Target Port(s)]
          -v : Be verbose [use twice -vv to be more verbose]
          -u : To switch to UDP

NETCAT TCP SCAN:                #MAKE IN VI AND CHMOD 777 TO MAKE IT EXECUTABLE
#!/bin/bash
echo "Enter network address (e.g. 192.168.0): "
read net
echo "Enter starting host range (e.g. 1): "
read start
echo "Enter ending host range (e.g. 254): "
read end
echo "Enter ports space-delimited (e.g. 21-23 80): "
read ports
for ((i=$start; $i<=$end; i++))
do
    nc -nvzw1 $net.$i $ports 2>&1 | grep -E 'succ|open' &
done
wait


NETCAT UDP SCAN:                  #MAKE IN VI AND CHMOD 777 TO MAKE IT EXECUTABLE
#!/bin/bash
echo "Enter network address (e.g. 192.168.0): "
read net
echo "Enter starting host range (e.g. 1): "
read start
echo "Enter ending host range (e.g. 254): "
read end
echo "Enter ports space-delimited (e.g. 21-23 80): "
read ports
for ((i=$start; $i<=$end; i++))
do
    nc -nuvzw1 $net.$i $ports 2>&1 | grep -E 'succ|open' &
done
wait


